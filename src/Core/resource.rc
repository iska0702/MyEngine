#include <winresrc.h>

1 24 app.manifest

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0X3FL
FILEFLAGS 0x0L
FILEOS 0X40004L
FILETYPE 0X1L
FILESUBTYPE 0X0L
BEGIN
    BLOCK StringFileInfo
    BEGIN
        BLOCK 040904b0
        BEGIN
            VALUE CompanyName, Idontknow
            VALUE FileDescription, Idontknow
            VALUE FileVersion, 1.0.0.0
            VALUE InternalName, Idontknow
            VALUE LegalCopyright, Copyright (C) 2026 Idontknow
            VALUE OriginalFilename, Idontknow.exe
            VALUE ProductName, Idontknow
            VALUE ProductVersion, 1.0.0.0
        END
    END
    BLOCK VarFileInfo
    BEGIN
        VALUE Translation, 0x409, 1200
    END
END
